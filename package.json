{
    "$schema": "https://www.schemastore.org/package.json",
    "private": true,
    "type": "module",
    "scripts": {
        "build": "vite build",
        "dev": "vite",
        "test:browser": "playwright test",
        "format": "prettier --write resources/css/app.css resources/js/*.js vite.config.js playwright.config.js tests/Browser/*.js package.json",
        "format:check": "prettier --check resources/css/app.css resources/js/*.js vite.config.js playwright.config.js tests/Browser/*.js package.json"
    },
    "dependencies": {
        "@alpinejs/focus": "^3.14.0",
        "@alpinejs/morph": "^3.17.5",
        "alpinejs": "^3.14.0",
        "laravel-echo": "^2.6.3",
        "leaflet": "1.9.4",
        "pusher-js": "^8.6.0",
        "sweetalert2": "11.26.25"
    },
    "devDependencies": {
        "@playwright/test": "^1.56.0",
        "@tailwindcss/vite": "^4.0.0",
        "concurrently": "^10.0.3",
        "laravel-vite-plugin": "^3.1",
        "prettier": "^3.10.0",
        "tailwindcss": "^4.0.0",
        "vite": "^8.0.0"
    }
}
