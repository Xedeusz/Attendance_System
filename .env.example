APP_NAME="Employee Attendance System"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

# Development policy proposals; confirm with HR and the DPO before production.
ATTENDANCE_CAPTURE_SECONDS=180
ATTENDANCE_LOCATION_MAX_AGE_SECONDS=45
ATTENDANCE_MAX_ACCURACY_METERS=50
ATTENDANCE_ALLOW_REVIEW_REQUESTS=true
ATTENDANCE_PHOTO_RETENTION_DAYS=30
ATTENDANCE_REVIEW_HOLD_DAYS=90

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=employee_biometric_db
DB_USERNAME=your_local_database_user
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax
SESSION_COOKIE=ebas_session
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=reverb
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=private_local
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="LIMCOMA Attendance System"
MAIL_REQUIRE_TLS=true
MAIL_TIMEOUT=15
MAIL_LINK_BASE_URL=
MAIL_MAX_MESSAGE_BYTES=20971520
MAIL_DAILY_LIMIT=400

# Enable only after configuring a real, tested private recovery delivery channel.
AUTH_PASSWORD_RESET_ENABLED=true

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# HR-only Photon search; no API key is required.
GEOCODING_PROVIDER=photon
PHOTON_BASE_URL=https://photon.komoot.io

# Generate private local credentials; never commit the real values from .env.
REVERB_APP_ID=limcoma-local
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST=127.0.0.1
REVERB_PORT=8080
REVERB_SCHEME=http
REVERB_ALLOWED_ORIGINS=127.0.0.1,localhost
# Public browser endpoint may differ from the internal publishing endpoint.
REVERB_PUBLIC_HOST=127.0.0.1
REVERB_PUBLIC_PORT=8080
REVERB_PUBLIC_SCHEME=http
REALTIME_POLL_SECONDS=15